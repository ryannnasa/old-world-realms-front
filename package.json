{
  "name": "warhammer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "type-check": "vue-tsc --build --force",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "security:full": "npm run security:audit && npm run security:scan",
    "security:scan": "npx secretlint \"**/*\" && npx license-checker --summary",
    "security:secrets": "npx secretlint \"**/*\"",
    "security:licenses": "npx license-checker --summary"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "keycloak-js": "^26.2.0",
    "lodash": "^4.17.21",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3",
    "vuetify": "^3.7.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "audit-ci": "^7.1.0",
    "jsdom": "^26.1.0",
    "license-checker": "^25.0.1",
    "npm-run-all2": "^8.0.4",
    "secretlint": "^11.2.0",
    "typescript": "~5.4.0",
    "vite": "^6.2.2",
    "vite-plugin-vue-devtools": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.0.21"
  }
}
